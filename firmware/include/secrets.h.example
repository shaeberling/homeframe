// Copy to secrets.h and fill in. secrets.h is gitignored.
#pragma once

#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"

// Base URL of the homeframe server (no trailing slash). Plain HTTP on the
// LAN keeps ~40KB of TLS buffers free — worth it on a no-PSRAM ESP32.
#define HF_SERVER_BASE "http://192.168.1.10:8080"

// Path the panel fetches. "/frame.bin" is the live dashboard; point it at a
// still image such as "/chalk.bin" to run an experiment on the real panel.
#define HF_FRAME_PATH "/frame.bin"

// Optional shared secret, sent as "X-Homeframe-Token". Leave empty to disable.
#define HF_SERVER_TOKEN ""
